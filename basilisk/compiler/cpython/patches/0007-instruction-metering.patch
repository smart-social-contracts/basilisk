+/* --- BASILISK instruction metering (ic-metering patch) ----------------
+ * Deterministic bytecode-instruction budget, counted once per DISPATCH().
+ * Cost for unmetered interpreters (budget == 0, always true for the main
+ * interpreter) is a single load+branch per instruction. When the metered
+ * interpreter exceeds its budget, _PyBasilisk_MeterTrip() raises the
+ * interpreter's registered BudgetExceeded exception (or RuntimeError as
+ * fallback) and we jump to the standard `error` unwind path — the same
+ * label every instruction body already uses, at a point where frame and
+ * stack_pointer are in a consistent state (end of an instruction).
+ * Instruction count, never wall-clock: identical code + inputs trip at
+ * the identical instruction on every replica. Once tripped, the check
+ * keeps re-raising on every subsequent dispatch, so a sandboxed
+ * `except:` cannot resume useful execution. */
+/* Returns 1 for a SOFT trip (raise the catchable BudgetExceeded so a
+ * sandbox handler may observe it once, for bounded cleanup) or 2 for a
+ * HARD trip (past the grace margin — code kept running after the soft
+ * trip). Both take the normal `error` path so stack/exc-info bookkeeping
+ * stays consistent; the hard trip additionally sets interp->
+ * basilisk_meter_killed, which forces the exception_unwind machinery to
+ * treat EVERY frame as handler-less (see the killed check in ceval.c).
+ * That guarantees the whole stack unwinds instead of a caught-in-a-loop
+ * BudgetExceeded livelocking. */
+extern int _PyBasilisk_MeterTrip(PyThreadState *tstate);
+
+#define BASILISK_METER_CHECK() \
+    do { \
+        uint64_t _b5k_budget = tstate->interp->basilisk_meter_budget; \
+        if (_b5k_budget != 0 && \
+                ++tstate->interp->basilisk_meter_used > _b5k_budget) { \
+            if (_PyBasilisk_MeterTrip(tstate) != 0) { goto error; } \
+        } \
+    } while (0)
+
 /* Do interpreter dispatch accounting for tracing and instrumentation */
