+/* --- BASILISK instruction metering (ic-metering patch) ----------------
+ * See the BASILISK_METER_CHECK() comment in ceval_macros.h for the hook.
+ * These functions are the host-facing control surface, called by the
+ * sandbox spawn/teardown primitive (basilisk_sandbox.c). They are plain
+ * exported symbols in the static archive; no header changes needed for
+ * out-of-tree callers, which declare them `extern`. */
+
+void
+_PyBasilisk_MeterEnable(PyThreadState *tstate, uint64_t budget,
+                        PyObject *exc_type)
+{
+    PyInterpreterState *interp = tstate->interp;
+    Py_XSETREF(interp->basilisk_meter_exc, Py_XNewRef(exc_type));
+    interp->basilisk_meter_used = 0;
+    interp->basilisk_meter_killed = 0;
+    interp->basilisk_meter_budget = budget;
+}
+
+/* Must be called with the metered interpreter ACTIVE (the exception type
+ * object belongs to it and is released here). */
+void
+_PyBasilisk_MeterDisable(PyThreadState *tstate)
+{
+    PyInterpreterState *interp = tstate->interp;
+    interp->basilisk_meter_budget = 0;
+    interp->basilisk_meter_used = 0;
+    interp->basilisk_meter_killed = 0;
+    Py_CLEAR(interp->basilisk_meter_exc);
+}
+
+uint64_t
+_PyBasilisk_MeterUsed(PyThreadState *tstate)
+{
+    return tstate->interp->basilisk_meter_used;
+}
+
+/* Grace margin (in bytecode instructions) granted AFTER the soft budget
+ * is first exceeded. Within the grace window the sandbox may catch
+ * BudgetExceeded to run bounded cleanup. Past it, the meter hard-kills:
+ * it bypasses every in-frame exception handler (the DISPATCH macro jumps
+ * to `exit_unwind`, not `error`), popping frames one dispatch at a time so
+ * a BudgetExceeded caught inside a loop cannot livelock. */
+#define BASILISK_METER_GRACE 100000ULL
+
+/* Called from BASILISK_METER_CHECK() when the budget is exceeded.
+ * Returns 1 for a soft trip (catchable), 2 for a hard trip (uncatchable
+ * unwind). Always leaves a Python exception set. */
+int
+_PyBasilisk_MeterTrip(PyThreadState *tstate)
+{
+    PyInterpreterState *interp = tstate->interp;
+    PyObject *exc = interp->basilisk_meter_exc;
+    if (exc == NULL) {
+        exc = PyExc_RuntimeError;
+    }
+    uint64_t over = interp->basilisk_meter_used - interp->basilisk_meter_budget;
+    if (over > BASILISK_METER_GRACE) {
+        /* Hard kill: past grace. Use a fresh RuntimeError (never the
+         * sandbox-nameable BudgetExceeded) and latch basilisk_meter_killed
+         * so exception_unwind ignores all handlers and the stack unwinds
+         * out completely. */
+        interp->basilisk_meter_killed = 1;
+        _PyErr_Format(tstate, PyExc_RuntimeError,
+                      "instruction budget (%llu) exhausted; sandbox "
+                      "terminated after grace period",
+                      (unsigned long long)interp->basilisk_meter_budget);
+        return 1;
+    }
+    _PyErr_Format(tstate, exc,
+                  "instruction budget (%llu) exhausted",
+                  (unsigned long long)interp->basilisk_meter_budget);
+    return 1;
+}
+
