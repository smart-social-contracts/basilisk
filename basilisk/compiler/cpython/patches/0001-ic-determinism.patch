+/* Internet Computer determinism note (Basilisk):
+ * The IC is a replicated state machine: all replicas must produce identical
+ * results, so Python's per-process hash randomization must be disabled.
+ *
+ * This is enforced in basilisk_cpython/src/cpython_init_helper.c by setting
+ * use_hash_seed=1 and hash_seed=0 on the PyConfig, which makes
+ * _Py_HashRandomization_Init() below zero out _Py_HashSecret instead of
+ * drawing entropy. (A historical -DPYTHONHASHSEED=0 compile flag was a
+ * no-op: no C source reads such a macro — PYTHONHASHSEED exists only as an
+ * environment variable, which the isolated config ignores.)
+ *
+ * If entropy IS drawn on wasm32-wasip1 (e.g. by os.urandom()), py_getentropy
+ * below resolves to WASI random_get, served by ic-wasi-polyfill's
+ * deterministic RNG (fixed zero seed at canister start, reseeded from
+ * raw_rand() shortly after init).
+ */
 #include "Python.h"
 #include "pycore_fileutils.h"     // _Py_fstat_noraise()
 #include "pycore_initconfig.h"
